{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(npm test)",
      "Bash(npm run:*)",
      "Bash(node scripts/:*)",
      "Bash(rm node_modules/.astro/data-store.json)",
      "mcp__search-console__analytics_query",
      "mcp__search-console__analytics_compare",
      "mcp__search-console__analytics_advanced",
      "mcp__search-console__analytics_anomalies",
      "mcp__search-console__compare_engines",
      "mcp__search-console__genai_query_insights",
      "mcp__search-console__indexing_status",
      "mcp__search-console__inspection_inspect",
      "mcp__search-console__pagespeed_analyze",
      "mcp__search-console__schema_validate",
      "mcp__search-console__seo_audit",
      "mcp__search-console__site_health_check",
      "mcp__search-console__sitemaps_list",
      "mcp__search-console__sites_list",
      "mcp__dataforseo__docs_search",
      "mcp__dataforseo__api_request"
    ],
    "deny": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npx wrangler:*)",
      "Read(//root/.ssh/**)",
      "Read(//home/vpc/.ssh/**)",
      "Read(//root/.claude.json)",
      "Read(//root/.claude/.credentials.json)",
      "Read(//root/.config/gh/**)",
      "Read(//root/.config/gsc/sa.json)",
      "Read(//root/.config/gsc/bing.env)",
      "Read(//home/vpc/.config/cloudflare/**)",
      "Read(//home/vpc/.hermes/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.github/**)",
      "Edit(.claude/settings.json)",
      "Edit(OWNERSHIP.md)",
      "Edit(ops/**)",
      "mcp__search-console__sitemaps_submit",
      "mcp__search-console__sitemaps_delete",
      "mcp__search-console__sites_manage",
      "mcp__search-console__indexing_submit",
      "mcp__search-console__accounts_manage",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__update_file"
    ]
  }
}
