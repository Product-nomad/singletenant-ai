---
import BaseLayout from './BaseLayout.astro';
import ConsultingCTA from '../components/ConsultingCTA.astro';

interface Props {
  title: string;
  description: string;
  pub_date: Date;
  updated?: Date;
  author: string;
  category: string;
  target_keyword?: string;
}

const { title, description, pub_date, updated, author, category } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: pub_date.toISOString(),
  dateModified: (updated ?? pub_date).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'singletenant.ai',
  },
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <article>
    <!-- Header -->
    <header class="border-b border-[var(--color-rule)]">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <p class="eyebrow mb-4">{category}</p>
        <h1 class="m-0 mb-6" style="font-size: clamp(2rem, 4.5vw, 3.5rem);">
          {title}
        </h1>
        <p class="text-xl mb-6" style="color: var(--color-ink-soft); line-height: 1.5;">
          {description}
        </p>
        <div class="text-sm font-mono pb-2" style="color: var(--color-mute);">
          By {author} ·
          <time datetime={pub_date.toISOString()}>
            {pub_date.toLocaleDateString('en-GB', {
              day: 'numeric', month: 'long', year: 'numeric'
            })}
          </time>
          {updated && (
            <>
              · Updated <time datetime={updated.toISOString()}>
                {updated.toLocaleDateString('en-GB', {
                  day: 'numeric', month: 'long', year: 'numeric'
                })}
              </time>
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Body -->
    <div class="mx-auto max-w-3xl px-6 py-12">
      <div class="prose">
        <slot />
      </div>
      <ConsultingCTA />
    </div>
  </article>
</BaseLayout>
