---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
// Preload the two latin woff2 the whole site actually paints with (body Inter
// and mono JetBrains). Importing the same source files that the @fontsource
// CSS references gives the identical hashed asset URL, so the preload matches
// the @font-face src instead of triggering a second download. @font-face
// carries font-display: swap from @fontsource, so text paints immediately in
// the fallback and the preloaded webfont swaps in with minimal shift (CLS).
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  ogTitle,
  ogImage = '/og-default.png',
  noIndex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullOgImage = new URL(ogImage, Astro.site).toString();
const titleWithBrand =
  title === 'singletenant.ai' ? title : `${title} | singletenant.ai`;
// Social title falls back to the branded <title>; the homepage overrides it
// with a descriptive value so its card is not just the bare brand name.
const socialTitle = ogTitle ?? titleWithBrand;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload critical fonts: fetched at document start, in parallel with the
         stylesheet, to cut font-driven layout shift and render-blocking. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={jetbrainsMonoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{titleWithBrand}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="singletenant.ai" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Schema.org -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Cloudflare Web Analytics: paste your token after deployment -->
    <!--
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js'
            data-cf-beacon='{"token": "YOUR_TOKEN"}'></script>
    -->

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml"
          title="singletenant.ai" href="/rss.xml" />
  </head>
  <body class="grain">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
