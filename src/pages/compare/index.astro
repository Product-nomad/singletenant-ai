---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const vendors = (await getCollection('vendors')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// Generate unique unordered pairs for the index (a-b is shown once, not twice)
const pairs: Array<[(typeof vendors)[0], (typeof vendors)[0]]> = [];
for (let i = 0; i < vendors.length; i++) {
  for (let j = i + 1; j < vendors.length; j++) {
    pairs.push([vendors[i], vendors[j]]);
  }
}
---

<BaseLayout
  title="Vendor Comparisons"
  description={`${pairs.length} side-by-side comparisons of single-tenant LLM hosting vendors. Find the right deployment partner for your compliance and operational requirements.`}
>
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="eyebrow mb-3">All Comparisons</p>
      <h1 class="m-0 mb-6" style="font-size: clamp(2.5rem, 5vw, 4rem);">
        Vendor by vendor.
      </h1>
      <p class="text-lg max-w-3xl" style="color: var(--color-ink-soft);">
        Pick any two vendors for a side-by-side comparison: deployment options,
        compliance posture, hardware availability, pricing, and where each one
        actually wins.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="eyebrow mb-6">{pairs.length} matchups</p>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none p-0 m-0">
        {pairs.map(([a, b]) => (
          <li class="m-0">
            <a href={`/compare/${a.data.slug}-vs-${b.data.slug}/`}
               class="block p-5 border border-[var(--color-rule)] no-underline hover:border-[var(--color-ink)] transition-colors">
              <span class="font-mono text-xs uppercase tracking-wider" style="color: var(--color-mute);">
                Comparison
              </span>
              <span class="block mt-2 font-display font-semibold" style="font-size: 1.1rem;">
                {a.data.name} <span style="color: var(--color-mute); font-weight: 400;">vs</span> {b.data.name}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
