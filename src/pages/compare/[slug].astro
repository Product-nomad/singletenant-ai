---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AdSlot from '../../components/AdSlot.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import VerifiedLine from '../../components/VerifiedLine.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { differencesSummary, pairIsIndexable } from '../../lib/compare.mjs';
import { oldest } from '../../lib/dates.mjs';
import { deploymentLabel, displayName } from '../../lib/labels.mjs';
import { vendorComparisonSchema } from '../../lib/schema.mjs';

export const getStaticPaths = (async () => {
  // One page per unordered pair, canonically ordered alphabetically by slug
  // (15 vendors → 105 pages). The reverse ordering 301s to the canonical URL
  // via _redirects; both directions as separate pages would be duplicate
  // content. See DECISIONS.md ADR on the '-vs-' separator.
  const vendors = (await getCollection('vendors')).sort((x, y) =>
    x.data.slug.localeCompare(y.data.slug),
  );
  const paths = [];

  for (let i = 0; i < vendors.length; i++) {
    for (let j = i + 1; j < vendors.length; j++) {
      const a = vendors[i];
      const b = vendors[j];
      paths.push({
        params: { slug: `${a.data.slug}-vs-${b.data.slug}` },
        props: { a, b },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { a, b } = Astro.props;

const title = `${displayName(a.data)} vs ${displayName(b.data)}`;
const description = `Side-by-side comparison of ${a.data.name} and ${b.data.name} for single-tenant LLM hosting. Deployment options, compliance, pricing, and operational fit compared.`;

// Find shared and differentiated deployment models
const sharedDeployment = a.data.deployment_models.filter((opt) =>
  b.data.deployment_models.includes(opt),
);
const aOnly = a.data.deployment_models.filter(
  (opt) => !b.data.deployment_models.includes(opt),
);
const bOnly = b.data.deployment_models.filter(
  (opt) => !a.data.deployment_models.includes(opt),
);

// Headline date: the older of the two profiles' last_verified, so the page
// never looks fresher than its stalest side.
const lastVerified = oldest([a.data.last_verified, b.data.last_verified]);

// Data-derived key differences (thin-page mitigation), every line computed
// from the two YAML records; unknowns say "not verified".
const differences = differencesSummary(a.data, b.data);

// Schema.org: the pairwise comparison as a Dataset (about the two vendor
// SoftwareApplications) plus a BreadcrumbList. See src/lib/schema.mjs.
const schema = vendorComparisonSchema({ a, b, description });

// Low-distinctiveness pairs stay reachable (both profiles and the /compare/
// picker link them) but are kept out of the index and the sitemap. Rule and
// threshold: src/lib/compare.mjs, AUDIT.md section 2.
const noIndex = !pairIsIndexable(a.data, b.data);
---

<BaseLayout title={title} description={description} schema={schema} noIndex={noIndex}>
  <!-- Header -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="eyebrow mb-3">
        <a href="/vendors/" style="color: var(--color-accent);">Vendors</a> · Comparison
      </p>
      <h1 class="m-0 mb-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
        {displayName(a.data)} <span style="color: var(--color-mute); font-weight: 400;">vs</span> {displayName(b.data)}
      </h1>
      <p class="text-lg max-w-3xl mb-4" style="color: var(--color-ink-soft);">
        {description}
      </p>
      <VerifiedLine date={lastVerified} note="(older of the two profiles)" />
    </div>
  </section>

  <!-- Quick verdict -->
  <section class="border-b border-[var(--color-rule)]"
           style="background: var(--color-paper-deep);">
    <div class="mx-auto max-w-5xl px-6 py-12 grid md:grid-cols-2 gap-8">
      <div class="p-6 bg-[var(--color-paper)] border border-[var(--color-rule)]">
        <h2 class="mt-0 mb-2" style="font-size: 1.25rem;">
          {displayName(a.data)}
        </h2>
        <p class="m-0 text-sm" style="line-height: 1.6;">
          {a.data.notes ?? a.data.tagline}
        </p>
      </div>
      <div class="p-6 bg-[var(--color-paper)] border border-[var(--color-rule)]">
        <h2 class="mt-0 mb-2" style="font-size: 1.25rem;">
          {displayName(b.data)}
        </h2>
        <p class="m-0 text-sm" style="line-height: 1.6;">
          {b.data.notes ?? b.data.tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- Key differences: generated from the vendor data, not written prose -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="eyebrow mb-3">From the data</p>
      <h2 class="mt-0 mb-6 pt-0 border-none">Key differences</h2>
      <ul class="list-none p-0 m-0 max-w-3xl">
        {differences.map((line) => (
          <li class="diff-line">
            <span class="diff-topic">{line.topic}</span>
            <span class="text-sm" style="color: var(--color-ink-soft); line-height: 1.6;">
              {line.text}
            </span>
          </li>
        ))}
      </ul>
      <p class="m-0 mt-4 text-xs font-mono" style="color: var(--color-mute);">
        Generated from the verified vendor data below; sources and dates on each
        vendor profile.
      </p>
    </div>
  </section>

  <!-- The comparison table -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="eyebrow mb-3">Side by side</p>
      <h2 class="mt-0 mb-8 pt-0 border-none">Capabilities compared</h2>
      <ComparisonTable vendors={[a, b]} />
    </div>
  </section>

  <!-- Differentiators -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="eyebrow mb-3">Where they diverge</p>
      <h2 class="mt-0 mb-6 pt-0 border-none">
        Deployment differentiation
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        <div>
          <p class="text-xs font-mono uppercase tracking-wider mb-3" style="color: var(--color-accent);">
            Only {a.data.name}
          </p>
          {aOnly.length === 0
            ? <p class="text-sm m-0" style="color: var(--color-mute);">
                Nothing exclusive in this category.
              </p>
            : <div>{aOnly.map((opt) => <span class="tag tag-accent">{deploymentLabel(opt)}</span>)}</div>
          }
        </div>
        <div>
          <p class="text-xs font-mono uppercase tracking-wider mb-3" style="color: var(--color-mute);">
            Both
          </p>
          {sharedDeployment.length === 0
            ? <p class="text-sm m-0" style="color: var(--color-mute);">
                No overlap in deployment models.
              </p>
            : <div>{sharedDeployment.map((opt) => <span class="tag">{deploymentLabel(opt)}</span>)}</div>
          }
        </div>
        <div>
          <p class="text-xs font-mono uppercase tracking-wider mb-3" style="color: var(--color-accent);">
            Only {b.data.name}
          </p>
          {bOnly.length === 0
            ? <p class="text-sm m-0" style="color: var(--color-mute);">
                Nothing exclusive in this category.
              </p>
            : <div>{bOnly.map((opt) => <span class="tag tag-accent">{deploymentLabel(opt)}</span>)}</div>
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Further reading -->
  <section>
    <div class="mx-auto max-w-3xl px-6 py-12">
      <p class="eyebrow mb-4">Read the full profiles</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href={`/vendors/${a.data.slug}/`}
           class="block p-5 border border-[var(--color-rule)] no-underline hover:border-[var(--color-ink)]">
          <span class="font-mono text-xs uppercase tracking-wider" style="color: var(--color-mute);">
            Profile →
          </span>
          <span class="block mt-1 font-display font-semibold" style="font-size: 1.1rem;">
            {displayName(a.data)}
          </span>
        </a>
        <a href={`/vendors/${b.data.slug}/`}
           class="block p-5 border border-[var(--color-rule)] no-underline hover:border-[var(--color-ink)]">
          <span class="font-mono text-xs uppercase tracking-wider" style="color: var(--color-mute);">
            Profile →
          </span>
          <span class="block mt-1 font-display font-semibold" style="font-size: 1.1rem;">
            {displayName(b.data)}
          </span>
        </a>
      </div>
      <AdSlot name="compare-end" />
    </div>
  </section>
</BaseLayout>

<style>
  .diff-line {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-rule);
    margin: 0;
  }

  .diff-line:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .diff-topic {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
    flex: 0 0 8rem;
  }
</style>
