---
import { getCollection } from 'astro:content';
import VendorMatrix from '../../components/VendorMatrix.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const vendors = await getCollection('vendors');
---

<BaseLayout
  title="LLM Hosting Vendors Directory"
  description="Directory of dedicated and single-tenant LLM hosting providers: deployment models, compliance certifications, pricing model, and data residency, each fact linked to a primary source."
>
  <section>
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <h1 class="m-0 mb-3" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); letter-spacing: -0.02em;">
        Vendors
      </h1>
      <p class="m-0 mb-8 max-w-3xl" style="color: var(--color-ink-soft);">
        {vendors.length} providers of dedicated or single-tenant LLM hosting,
        ordered alphabetically. Click a vendor for the full evidence-linked
        profile.
      </p>

      <VendorMatrix vendors={vendors} />
    </div>
  </section>
</BaseLayout>
