---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import CategoryTag from '../../components/CategoryTag.astro';
import CertBadge from '../../components/CertBadge.astro';
import ConsultingCTA from '../../components/ConsultingCTA.astro';
import EvidenceLink from '../../components/EvidenceLink.astro';
import LastVerified from '../../components/LastVerified.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NOT_VERIFIED } from '../../lib/labels.mjs';

export const getStaticPaths = (async () => {
  const vendors = await getCollection('vendors');
  return vendors.map((vendor) => ({
    params: { slug: vendor.data.slug },
    props: { vendor },
  }));
}) satisfies GetStaticPaths;

const { vendor } = Astro.props;
const { data } = vendor;

// Schema.org SoftwareApplication
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.name,
  url: data.url,
  description: data.tagline,
  applicationCategory: 'AI/ML Infrastructure',
  operatingSystem: 'Cloud',
};

const allVendors = await getCollection('vendors');
const compareCandidates = allVendors
  .filter((v) => v.data.slug !== data.slug)
  .slice(0, 4);

const fmtUnknown = (val: string | boolean) => {
  if (val === 'unknown') return NOT_VERIFIED;
  if (typeof val === 'boolean') return val ? 'Yes' : 'No';
  return val;
};
---

<BaseLayout
  title={`${data.name} — Single-Tenant LLM Hosting Profile`}
  description={data.tagline}
  schema={schema}
>
  <!-- Header -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-10">
      <p class="eyebrow mb-3">
        <a href="/vendors/" style="color: var(--color-accent);">Vendors</a> · Profile
      </p>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-2">
        <h1 class="m-0" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); letter-spacing: -0.02em;">
          {data.name}
        </h1>
        <CategoryTag category={data.category} />
      </div>
      <p class="m-0 mb-5" style="color: var(--color-ink-soft);">{data.tagline}</p>
      <AffiliateLink vendor={data} />
    </div>
  </section>

  <!-- Facts — every populated claim carries evidence; gaps say "Not verified" -->
  <section>
    <div class="mx-auto max-w-5xl px-6 py-10 space-y-10">
      <div>
        <div class="fact-section-head">
          <h2 class="m-0">Deployment</h2>
        </div>
        <table class="data-table">
          <tbody>
            <tr>
              <td class="fact-label">Deployment models</td>
              <td>
                {data.deployment_models.length > 0
                  ? data.deployment_models.join(', ')
                  : NOT_VERIFIED}
              </td>
            </tr>
            <tr>
              <td class="fact-label">Regions</td>
              <td>{data.regions.length > 0 ? data.regions.join(', ') : NOT_VERIFIED}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div>
        <div class="fact-section-head">
          <h2 class="m-0">Compliance</h2>
        </div>
        {
          data.compliance.length === 0 ? (
            <p class="m-0 text-sm font-mono" style="color: var(--color-mute);">
              {NOT_VERIFIED}
            </p>
          ) : (
            <table class="data-table">
              <tbody>
                {data.compliance.map((c) => (
                  <tr>
                    <td>
                      <CertBadge cert={c.cert} evidenceUrl={c.evidence_url} verified={c.verified} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>

      <div>
        <div class="fact-section-head">
          <h2 class="m-0">Pricing</h2>
          {data.pricing.evidence_url && <EvidenceLink url={data.pricing.evidence_url} />}
          <LastVerified date={data.pricing.verified} />
        </div>
        <table class="data-table">
          <tbody>
            <tr>
              <td class="fact-label">Pricing model</td>
              <td>{fmtUnknown(data.pricing.model)}</td>
            </tr>
            <tr>
              <td class="fact-label">Public pricing</td>
              <td>{fmtUnknown(data.pricing.public)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div>
        <div class="fact-section-head">
          <h2 class="m-0">Sovereignty</h2>
          {data.sovereignty.evidence_url && <EvidenceLink url={data.sovereignty.evidence_url} />}
          <LastVerified date={data.sovereignty.verified} />
        </div>
        <table class="data-table">
          <tbody>
            <tr>
              <td class="fact-label">Data residency guarantee</td>
              <td>{fmtUnknown(data.sovereignty.data_residency_guarantee)}</td>
            </tr>
            <tr>
              <td class="fact-label">Parent jurisdiction</td>
              <td>{fmtUnknown(data.sovereignty.parent_jurisdiction)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      {
        data.notes && (
          <div>
            <div class="fact-section-head">
              <h2 class="m-0">Analyst note</h2>
            </div>
            <p class="m-0 max-w-3xl" style="color: var(--color-ink-soft);">
              {data.notes}
            </p>
          </div>
        )
      }

      {
        compareCandidates.length > 0 && (
          <div>
            <div class="fact-section-head">
              <h2 class="m-0">Compare {data.name} vs…</h2>
            </div>
            <ul class="list-none p-0 grid sm:grid-cols-2 gap-3 m-0">
              {compareCandidates.map((other) => (
                <li class="m-0">
                  <a
                    href={`/compare/${data.slug}-vs-${other.data.slug}/`}
                    class="block p-4 border border-[var(--color-rule)] no-underline hover:border-[var(--color-ink)]"
                  >
                    <span
                      class="font-mono text-xs uppercase tracking-wider"
                      style="color: var(--color-mute);"
                    >
                      Comparison
                    </span>
                    <span class="block mt-1 font-semibold" style="font-size: 1rem;">
                      {data.name} vs {other.data.name}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="max-w-3xl">
        <ConsultingCTA />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .fact-section-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--color-ink);
    padding-bottom: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .fact-section-head h2 {
    font-size: 1.1rem;
    border: none;
    padding: 0;
  }

  .fact-label {
    font-family: var(--font-sans);
    color: var(--color-mute);
    width: 14rem;
  }
</style>
