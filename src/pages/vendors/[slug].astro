---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ConsultingCTA from '../../components/ConsultingCTA.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const vendors = await getCollection('vendors');
  return vendors.map((vendor) => ({
    params: { slug: vendor.data.slug },
    props: { vendor },
  }));
}) satisfies GetStaticPaths;

const { vendor } = Astro.props;
const { data } = vendor;

// Schema.org SoftwareApplication
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.name,
  url: data.url,
  description: data.tagline,
  applicationCategory: 'AI/ML Infrastructure',
  operatingSystem: 'Cloud',
};

const allVendors = await getCollection('vendors');
const compareCandidates = allVendors
  .filter((v) => v.data.slug !== data.slug)
  .slice(0, 4);

// Latest verified date across evidence-carrying blocks
const verifiedDates = [
  ...data.compliance.map((c) => c.verified),
  data.pricing.verified,
  data.sovereignty.verified,
].filter((d): d is string => Boolean(d));
const lastVerified =
  verifiedDates.length > 0 ? verifiedDates.sort().at(-1) : undefined;

const fmtUnknown = (val: string | boolean) => {
  if (val === 'unknown') return 'Not verified';
  if (typeof val === 'boolean') return val ? 'Yes' : 'No';
  return val;
};
const evidenceDomain = (url: string) => new URL(url).hostname;
---

<BaseLayout
  title={`${data.name} — Single-Tenant LLM Hosting Profile`}
  description={data.tagline}
  schema={schema}
>
  <!-- Header -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="eyebrow mb-3">
        <a href="/vendors/" style="color: var(--color-accent);">Vendors</a> · Profile
      </p>
      <h1 class="m-0 mb-3" style="font-size: clamp(2.5rem, 5vw, 4rem);">
        {data.name}
      </h1>
      <p class="text-lg italic mb-6" style="color: var(--color-ink-soft);">
        {data.tagline}
      </p>
      <div class="flex flex-wrap gap-3 items-center">
        <a href={data.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Visit {data.name} ↗
        </a>
        <span class="tag">{data.category}</span>
      </div>
    </div>
  </section>

  <!-- Two-column body -->
  <section>
    <div class="mx-auto max-w-5xl px-6 py-12 grid md:grid-cols-3 gap-12">

      <!-- Main column -->
      <article class="md:col-span-2">
        {data.notes && (
          <>
            <h2 class="mt-0 pt-0 border-none">Analyst note</h2>
            <p class="prose">{data.notes}</p>
          </>
        )}

        {compareCandidates.length > 0 && (
          <>
            <h2>Compare {data.name} vs…</h2>
            <ul class="list-none p-0 grid sm:grid-cols-2 gap-3 m-0">
              {compareCandidates.map((other) => (
                <li class="m-0">
                  <a href={`/compare/${data.slug}-vs-${other.data.slug}/`}
                     class="block p-4 border border-[var(--color-rule)] no-underline hover:border-[var(--color-ink)]">
                    <span class="font-mono text-xs uppercase tracking-wider" style="color: var(--color-mute);">
                      Comparison
                    </span>
                    <span class="block mt-1 font-display font-semibold" style="font-size: 1rem;">
                      {data.name} vs {other.data.name}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        <ConsultingCTA />
      </article>

      <!-- Facts sidebar — every claim evidence-linked or "Not verified" -->
      <aside class="md:col-span-1">
        <div class="sticky top-6 space-y-8">
          <div>
            <p class="eyebrow mb-3">Deployment models</p>
            <div>
              {data.deployment_models.length === 0
                ? <p class="m-0 text-sm font-mono" style="color: var(--color-mute);">Not verified</p>
                : data.deployment_models.map((opt) => <span class="tag">{opt}</span>)}
            </div>
          </div>

          <div>
            <p class="eyebrow mb-3">Regions</p>
            {data.regions.length === 0
              ? <p class="m-0 text-sm font-mono" style="color: var(--color-mute);">Not verified</p>
              : <ul class="list-none p-0 m-0 space-y-1 text-sm font-mono">
                  {data.regions.map((r) => <li>· {r}</li>)}
                </ul>}
          </div>

          <div>
            <p class="eyebrow mb-3">Compliance</p>
            {data.compliance.length === 0
              ? <p class="m-0 text-sm font-mono" style="color: var(--color-mute);">Not verified</p>
              : <ul class="list-none p-0 m-0 space-y-2 text-sm font-mono">
                  {data.compliance.map((c) => (
                    <li>
                      <span class="tag">{c.cert}</span>
                      <a href={c.evidence_url} target="_blank" rel="noopener noreferrer"
                         class="text-xs" style="color: var(--color-mute);">
                        {evidenceDomain(c.evidence_url)} ↗
                      </a>
                      <span class="block text-xs" style="color: var(--color-mute);">
                        verified {c.verified}
                      </span>
                    </li>
                  ))}
                </ul>}
          </div>

          <div>
            <p class="eyebrow mb-3">Pricing</p>
            <p class="m-0 text-sm" style="line-height: 1.5;">
              {fmtUnknown(data.pricing.model)}
            </p>
            <p class="mt-1 mb-0 text-xs font-mono" style="color: var(--color-mute);">
              Public pricing: {fmtUnknown(data.pricing.public)}
            </p>
            {data.pricing.evidence_url && (
              <p class="mt-1 mb-0 text-xs font-mono" style="color: var(--color-mute);">
                <a href={data.pricing.evidence_url} target="_blank" rel="noopener noreferrer">
                  {evidenceDomain(data.pricing.evidence_url)} ↗
                </a>
                · verified {data.pricing.verified}
              </p>
            )}
          </div>

          <div>
            <p class="eyebrow mb-3">Sovereignty</p>
            <dl class="space-y-3 m-0 text-sm font-mono">
              <div class="flex justify-between border-b border-[var(--color-rule)] pb-2">
                <dt style="color: var(--color-mute);">Residency guarantee</dt>
                <dd class="m-0">{fmtUnknown(data.sovereignty.data_residency_guarantee)}</dd>
              </div>
              <div class="flex justify-between border-b border-[var(--color-rule)] pb-2">
                <dt style="color: var(--color-mute);">Parent jurisdiction</dt>
                <dd class="m-0">{fmtUnknown(data.sovereignty.parent_jurisdiction)}</dd>
              </div>
            </dl>
            {data.sovereignty.evidence_url && (
              <p class="mt-2 mb-0 text-xs font-mono" style="color: var(--color-mute);">
                <a href={data.sovereignty.evidence_url} target="_blank" rel="noopener noreferrer">
                  {evidenceDomain(data.sovereignty.evidence_url)} ↗
                </a>
                · verified {data.sovereignty.verified}
              </p>
            )}
          </div>

          {lastVerified && (
            <p class="text-xs font-mono pt-4 border-t border-[var(--color-rule)]" style="color: var(--color-mute);">
              Last verified: {lastVerified}
            </p>
          )}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
