---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]}
  description="How to reach singletenant.ai: factual corrections, vendor submissions, and press enquiries."
>
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <p class="eyebrow mb-3">Contact</p>
      <h1 class="m-0 mb-6" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
        Contact
      </h1>

      <div class="prose">
        <h2>Corrections</h2>
        <p>
          If a fact on this site is wrong or out of date, email
          <a href="mailto:simon@singletenant.ai">simon@singletenant.ai</a>
          with the page, the claim, and a link to the primary source that
          contradicts it. How corrections are handled is set out in the
          <a href="/editorial-policy/#corrections">editorial policy</a>.
        </p>

        <h2>Vendor submissions</h2>
        <p>
          Vendors that offer a documented dedicated or single-tenant
          deployment option can ask to be considered for inclusion, or send
          corrections about their own profile, at the same address. Inclusion
          follows the criteria on the <a href="/methodology/">methodology</a>
          page and cannot be bought.
        </p>

        <h2>Press and everything else</h2>
        <p>
          <a href="mailto:simon@singletenant.ai">simon@singletenant.ai</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
