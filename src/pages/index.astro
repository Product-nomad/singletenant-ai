---
import { getCollection } from 'astro:content';
import ConsultingCTA from '../components/ConsultingCTA.astro';
import VendorMatrix from '../components/VendorMatrix.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadChangelog } from '../lib/changelog.mjs';

const vendors = await getCollection('vendors');

// Stats computed from the data, never hardcoded
const certsMapped = new Set(
  vendors.flatMap((v) => v.data.compliance.map((c) => c.cert)),
).size;
const [latestChange] = loadChangelog();

const articles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = articles
  .sort((a, b) => b.data.pub_date.valueOf() - a.data.pub_date.valueOf())
  .slice(0, 3);

const description =
  'Evidence-linked reference data on dedicated and single-tenant LLM hosting: deployment models, compliance certifications, pricing, and data residency for regulated industries.';

// WebSite + publisher Organization JSON-LD for the homepage. Only facts the
// site actually stands behind: name, URL, description, publisher.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'singletenant.ai',
  url: 'https://singletenant.ai/',
  description,
  publisher: {
    '@type': 'Organization',
    name: 'singletenant.ai',
    url: 'https://singletenant.ai/',
    logo: 'https://singletenant.ai/favicon.svg',
  },
};
---

<BaseLayout title="singletenant.ai" description={description} schema={schema}>
  <!-- Hero: the matrix is the product -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <h1 class="m-0 mb-3" style="font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -0.02em;">
        Dedicated &amp; single-tenant LLM hosting, evidence-linked.
      </h1>
      <p class="m-0 mb-8 max-w-3xl" style="color: var(--color-ink-soft);">
        Every fact below links to a primary source with the date it was last
        verified. Facts we could not verify are marked, not guessed.
      </p>

      <dl class="stat-strip">
        <div>
          <dt>Vendors tracked</dt>
          <dd>{vendors.length}</dd>
        </div>
        <div>
          <dt>Compliance certs mapped</dt>
          <dd>{certsMapped}</dd>
        </div>
        <div>
          <dt>Last data change</dt>
          <dd>
            <a href="/changelog/" class="no-underline">
              {new Date(latestChange.date).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })}
            </a>
          </dd>
        </div>
      </dl>

      <VendorMatrix vendors={vendors} />
    </div>
  </section>

  <!-- Consulting CTA -->
  <section>
    <div class="mx-auto max-w-4xl px-6">
      <ConsultingCTA />
    </div>
  </section>

  <!-- Latest articles -->
  {recentArticles.length > 0 && (
    <section class="border-t border-[var(--color-rule)]">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="flex items-end justify-between mb-8 pb-4 rule-thick">
          <div>
            <p class="eyebrow mb-2">Analysis</p>
            <h2 class="m-0">Latest articles</h2>
          </div>
          <a href="/blog/" class="font-mono text-xs uppercase tracking-wider hidden sm:inline-block">
            All articles →
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {recentArticles.map((article) => (
            <article class="border-t-2 border-[var(--color-ink)] pt-4">
              <p class="eyebrow mb-2">{article.data.category}</p>
              <h3 class="mb-3" style="font-size: 1.4rem;">
                <a href={`/blog/${article.id}/`} class="no-underline">
                  {article.data.title}
                </a>
              </h3>
              <p class="text-sm mb-3" style="color: var(--color-ink-soft); line-height: 1.55;">
                {article.data.description}
              </p>
              <p class="text-xs font-mono m-0" style="color: var(--color-mute);">
                {article.data.pub_date.toLocaleDateString('en-GB', {
                  day: 'numeric', month: 'short', year: 'numeric'
                })}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin: 0 0 2rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .stat-strip dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .stat-strip dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
