---
// VendorMatrix: the site's hero component (spec §4): a dense, filterable
// comparison table driven entirely by the vendor YAML collection.
//
// Progressive enhancement: the full table renders statically; the filter
// bar ships `hidden` and is revealed by the enhancement script. With JS
// disabled the reader gets the complete matrix, never a broken filter.
import type { CollectionEntry } from 'astro:content';
import {
  alternateNames,
  CATEGORY_LABELS,
  CERT_LABELS,
  deploymentLabel,
  EVIDENCE_LEVEL_LABELS,
  evidenceLevelLabel,
  jurisdictionName,
  NOT_VERIFIED,
  regionLabel,
} from '../lib/labels.mjs';
import CategoryTag from './CategoryTag.astro';

interface Props {
  vendors: CollectionEntry<'vendors'>[];
  // Homepage passes this to default to the first-visit scan set (5 columns)
  // with a "Show all columns" toggle. The full directory omits it and shows
  // every column. Progressive enhancement: with JS off, the full table renders
  // either way (the collapse is applied by the enhancement script).
  collapsible?: boolean;
}

const { vendors, collapsible = false } = Astro.props;
const sorted = [...vendors].sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// Only offer filters for values that exist in the data, no dead controls.
const categoriesPresent = Object.keys(CATEGORY_LABELS).filter((c) =>
  sorted.some((v) => v.data.category === c),
);
const certsPresent = Object.keys(CERT_LABELS).filter((cert) =>
  sorted.some((v) => v.data.compliance.some((e) => e.cert === cert)),
);
const byName = (a: string, b: string) =>
  jurisdictionName(a).localeCompare(jurisdictionName(b));
const parentsPresent = [
  ...new Set(
    sorted
      .map((v) => v.data.sovereignty.parent_jurisdiction)
      .filter((j) => j !== 'unknown'),
  ),
].sort(byName);
const sovereignPresent = [
  ...new Set(sorted.flatMap((v) => v.data.sovereign_for)),
].sort(byName);

// Search text per row: every name a reader might type, old and new.
const searchText = (d: CollectionEntry<'vendors'>['data']) =>
  [d.name, ...alternateNames(d), d.slug].join(' ').toLowerCase();
const pricingLabel = (model: string) =>
  model === 'unknown' ? NOT_VERIFIED : model;
---

<div data-vendor-matrix data-collapsible={collapsible ? '' : undefined}>
  <form class="matrix-filters" data-matrix-filters hidden>
    <fieldset class="filter-group">
      <legend>Category</legend>
      <div class="filter-options" role="group">
        <button type="button" data-filter-cat="all" aria-pressed="true">All</button>
        {categoriesPresent.map((c) => (
          <button type="button" data-filter-cat={c} aria-pressed="false">
            {CATEGORY_LABELS[c as keyof typeof CATEGORY_LABELS]}
          </button>
        ))}
      </div>
    </fieldset>

    <fieldset class="filter-group">
      <legend>Parent jurisdiction</legend>
      <div class="filter-options" role="group">
        <button type="button" data-filter-jur="all" aria-pressed="true">All</button>
        {parentsPresent.map((j) => (
          <button type="button" data-filter-jur={j} aria-pressed="false">
            {jurisdictionName(j)}
          </button>
        ))}
      </div>
    </fieldset>

    {sovereignPresent.length > 0 && (
      <fieldset class="filter-group">
        <legend>Sovereign for</legend>
        <div class="filter-options" role="group">
          <button type="button" data-filter-sov="all" aria-pressed="true">Any</button>
          {sovereignPresent.map((j) => (
            <button type="button" data-filter-sov={j} aria-pressed="false">
              {jurisdictionName(j)}
            </button>
          ))}
        </div>
      </fieldset>
    )}

    {certsPresent.length > 0 && (
      <fieldset class="filter-group">
        <legend>Compliance</legend>
        <div class="filter-options">
          {certsPresent.map((cert) => (
            <label class="cert-option">
              <input type="checkbox" data-filter-cert={cert} />
              {CERT_LABELS[cert as keyof typeof CERT_LABELS]}
            </label>
          ))}
          <label class="cert-option level-option">
            <input type="checkbox" data-filter-contractual-only />
            {EVIDENCE_LEVEL_LABELS.contractual} evidence only
          </label>
        </div>
      </fieldset>
    )}

    <fieldset class="filter-group">
      <legend>Data residency evidence</legend>
      <div class="filter-options" role="group">
        <button type="button" data-filter-res="all" aria-pressed="true">Any</button>
        <button type="button" data-filter-res="contractual" aria-pressed="false">
          {EVIDENCE_LEVEL_LABELS.contractual}
        </button>
        <button type="button" data-filter-res="stated" aria-pressed="false">
          {EVIDENCE_LEVEL_LABELS.contractual} or {EVIDENCE_LEVEL_LABELS.stated.toLowerCase()}
        </button>
      </div>
    </fieldset>

    <fieldset class="filter-group">
      <legend><label for="matrix-search">Find a vendor</label></legend>
      <div class="filter-options">
        <input
          id="matrix-search"
          type="search"
          class="matrix-search"
          placeholder="Name, old or new"
          autocomplete="off"
          data-filter-search
        />
      </div>
    </fieldset>

    <p class="matrix-legend">
      Evidence levels: {EVIDENCE_LEVEL_LABELS.contractual} = contract terms, or a
      certificate or audit report; {EVIDENCE_LEVEL_LABELS.stated} = the vendor's
      own pages. <a href="/methodology/#evidence-levels">How levels are set</a>.
    </p>

    <p class="matrix-count" data-matrix-count aria-live="polite"></p>
  </form>

  {collapsible && (
    <button type="button" class="cols-toggle" data-cols-toggle aria-pressed="false" hidden>
      Show all columns
    </button>
  )}

  <div class="matrix-scroll">
    <table class="data-table matrix-table">
      <thead>
        <tr>
          <th scope="col">Vendor</th>
          <th scope="col">Category</th>
          <th scope="col" class="matrix-col-extra">Deployment</th>
          <th scope="col">Regions</th>
          <th scope="col">Compliance</th>
          <th scope="col" class="matrix-col-extra">Pricing</th>
          <th scope="col">Data residency</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map(({ data }) => (
          <tr
            data-matrix-row
            data-category={data.category}
            data-certs={data.compliance.map((e) => e.cert).join(' ')}
            data-certs-contractual={data.compliance
              .filter((e) => e.level === 'contractual')
              .map((e) => e.cert)
              .join(' ')}
            data-residency={data.sovereignty.data_residency_guarantee}
            data-jurisdiction={data.sovereignty.parent_jurisdiction}
            data-sovereign-for={data.sovereign_for.join(' ')}
            data-search={searchText(data)}
          >
            <th scope="row">
              <a href={`/vendors/${data.slug}/`}>
                {data.renamed ? (
                  <>
                    {data.renamed.from}
                    <span class="now-named">(now {data.renamed.to})</span>
                  </>
                ) : (
                  data.name
                )}
              </a>
            </th>
            <td><CategoryTag category={data.category} /></td>
            <td class="matrix-col-extra">
              {data.deployment_models.length > 0
                ? data.deployment_models.map(deploymentLabel).join(', ')
                : NOT_VERIFIED}
            </td>
            <td>{data.regions.length > 0 ? data.regions.map(regionLabel).join(', ') : NOT_VERIFIED}</td>
            <td>
              {data.compliance.length > 0
                ? data.compliance.map((e, i) => (
                    <>
                      {i > 0 && ', '}
                      {CERT_LABELS[e.cert as keyof typeof CERT_LABELS]}
                      {e.level === 'stated' && (
                        <span class="level-mark" title="Stated on the vendor's own pages, not contractual">
                          {' '}(stated)
                        </span>
                      )}
                    </>
                  ))
                : NOT_VERIFIED}
            </td>
            <td class="matrix-col-extra">{pricingLabel(data.pricing.model)}</td>
            <td>
              {evidenceLevelLabel(data.sovereignty.data_residency_guarantee)}
              {data.sovereignty.parent_jurisdiction !== 'unknown' && (
                <span class="jurisdiction">
                  ({jurisdictionName(data.sovereignty.parent_jurisdiction)} parent)
                </span>
              )}
              {data.sovereign_for.length > 0 && (
                <span class="jurisdiction">
                  Sovereign for {data.sovereign_for.map(jurisdictionName).join(', ')}
                </span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="matrix-note">
    Three separate facts: <strong>category</strong> is how the service is
    delivered; <strong>parent jurisdiction</strong> is the country whose law
    governs the parent company; <strong>data residency</strong> is whether the
    vendor commits to keeping data in a chosen region, graded Contractual,
    Stated or Not verified. A region in one country does not change the
    parent's jurisdiction. "Sovereign for" is recorded only where parent,
    capacity, residency and the vendor's own claim all point at the same
    jurisdiction (<a href="/methodology/#sovereign-for">how it is set</a>;
    <a href="/jurisdictions/">by jurisdiction</a>).
  </p>
</div>

<script>
  for (const matrix of document.querySelectorAll('[data-vendor-matrix]')) {
    const filters = matrix.querySelector<HTMLElement>('[data-matrix-filters]');
    const rows = matrix.querySelectorAll<HTMLElement>('[data-matrix-row]');
    const count = matrix.querySelector<HTMLElement>('[data-matrix-count]');
    if (!filters) continue;

    const catButtons = filters.querySelectorAll<HTMLButtonElement>('[data-filter-cat]');
    const certBoxes = filters.querySelectorAll<HTMLInputElement>('[data-filter-cert]');
    const contractualOnly = filters.querySelector<HTMLInputElement>('[data-filter-contractual-only]');
    const resButtons = filters.querySelectorAll<HTMLButtonElement>('[data-filter-res]');
    const search = filters.querySelector<HTMLInputElement>('[data-filter-search]');
    const jurButtons = filters.querySelectorAll<HTMLButtonElement>('[data-filter-jur]');
    const sovButtons = filters.querySelectorAll<HTMLButtonElement>('[data-filter-sov]');
    // Each single-choice group holds 'all' or a set of wanted values (a
    // comma-separated deep link can select several).
    let activeCat: string | string[] = 'all';
    let activeJur: string | string[] = 'all';
    let activeSov: string | string[] = 'all';
    let activeRes = 'all';
    const matches = (active: string | string[], values: string[]) =>
      active === 'all' ||
      (Array.isArray(active)
        ? active.some((a) => values.includes(a))
        : values.includes(active));

    const apply = () => {
      const wantedCerts = [...certBoxes]
        .filter((b) => b.checked)
        .map((b) => b.dataset.filterCert ?? '');
      let shown = 0;
      for (const row of rows) {
        const catOk = matches(activeCat, [row.dataset.category ?? '']);
        const jurOk = matches(activeJur, [row.dataset.jurisdiction ?? '']);
        const sovOk = matches(
          activeSov,
          (row.dataset.sovereignFor ?? '').split(' ').filter(Boolean),
        );
        const rowCerts = (
          contractualOnly?.checked ? row.dataset.certsContractual : row.dataset.certs
        ) ?? '';
        const certsOk = wantedCerts.every((c) => rowCerts.split(' ').includes(c));
        // 'stated' means stated or better; 'contractual' means contractual only.
        const res = row.dataset.residency ?? 'unknown';
        const resOk =
          activeRes === 'all' ||
          (activeRes === 'contractual' && res === 'contractual') ||
          (activeRes === 'stated' && res !== 'unknown');
        const query = (search?.value ?? '').trim().toLowerCase();
        const searchOk = query === '' || (row.dataset.search ?? '').includes(query);
        const visible = catOk && jurOk && sovOk && certsOk && resOk && searchOk;
        row.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === rows.length
            ? `All ${rows.length} vendors shown`
            : `${shown} of ${rows.length} vendors shown`;
      }
    };

    // Single-choice button groups share one wiring: press one, unpress the rest.
    const wireGroup = (
      buttons: NodeListOf<HTMLButtonElement>,
      key: string,
      set: (v: string) => void,
    ) => {
      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          set(btn.dataset[key] ?? 'all');
          for (const b of buttons) {
            b.setAttribute('aria-pressed', String(b === btn));
          }
          apply();
        });
      }
    };
    wireGroup(catButtons, 'filterCat', (v) => { activeCat = v; });
    wireGroup(jurButtons, 'filterJur', (v) => { activeJur = v; });
    wireGroup(sovButtons, 'filterSov', (v) => { activeSov = v; });
    for (const box of certBoxes) {
      box.addEventListener('change', apply);
    }
    contractualOnly?.addEventListener('change', apply);
    search?.addEventListener('input', apply);
    wireGroup(resButtons, 'filterRes', (v) => { activeRes = v; });

    // Deep links (progressive enhancement; without JS the full table shows):
    //   ?category=<slug>, ?jurisdiction=<CODE>, ?sovereign=<CODE>
    // each comma-separated for several values. Retired geographic categories
    // (eu-sovereign, uk-sovereign) map to the equivalent Sovereign for filter
    // and the address bar is rewritten to the new URL.
    const LEGACY_CATEGORY: Record<string, string> = {
      'eu-sovereign': 'EU',
      'uk-sovereign': 'GB',
    };
    const params = new URLSearchParams(window.location.search);
    const split = (v: string | null) =>
      (v ?? '').split(',').map((s) => s.trim()).filter(Boolean);
    const cats = split(params.get('category'));
    const legacy = cats.filter((c) => c in LEGACY_CATEGORY);
    if (legacy.length > 0) {
      const sov = new Set([
        ...split(params.get('sovereign')),
        ...legacy.map((c) => LEGACY_CATEGORY[c]),
      ]);
      const rest = cats.filter((c) => !(c in LEGACY_CATEGORY));
      if (rest.length > 0) params.set('category', rest.join(','));
      else params.delete('category');
      params.set('sovereign', [...sov].join(','));
      history.replaceState(
        null,
        '',
        `${window.location.pathname}?${params.toString().replaceAll('%2C', ',')}${window.location.hash}`,
      );
    }

    // Press the matching button for one value; several values filter to the
    // set with no single button pressed. Unknown values are ignored.
    const preselect = (
      buttons: NodeListOf<HTMLButtonElement>,
      key: string,
      wanted: string[],
      set: (v: string | string[]) => void,
    ) => {
      const valid = wanted.filter((w) => [...buttons].some((b) => b.dataset[key] === w));
      if (valid.length === 0) return;
      set(valid.length === 1 ? valid[0] : valid);
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(valid.length === 1 && b.dataset[key] === valid[0]));
      }
    };
    preselect(catButtons, 'filterCat', split(params.get('category')), (v) => { activeCat = v; });
    preselect(jurButtons, 'filterJur', split(params.get('jurisdiction')), (v) => { activeJur = v; });
    preselect(sovButtons, 'filterSov', split(params.get('sovereign')), (v) => { activeSov = v; });

    // First-visit column set (homepage only): collapse to the 5-column scan set
    // and offer a toggle that reveals Deployment + Pricing. Progressive
    // enhancement: the static table ships with every column, and this runs only
    // when JS is present, so no-JS readers always get the full table.
    const colsToggle = matrix.querySelector<HTMLButtonElement>('[data-cols-toggle]');
    if (matrix.hasAttribute('data-collapsible') && colsToggle) {
      matrix.classList.add('cols-collapsed');
      colsToggle.hidden = false;
      colsToggle.addEventListener('click', () => {
        const collapsed = matrix.classList.toggle('cols-collapsed');
        colsToggle.setAttribute('aria-pressed', String(!collapsed));
        colsToggle.textContent = collapsed
          ? 'Show all columns'
          : 'Show fewer columns';
      });
    }

    filters.hidden = false;
    apply();
  }
</script>

<style>
  .matrix-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 2.5rem;
    margin-bottom: 1.25rem;
  }

  .filter-group {
    border: none;
    margin: 0;
    padding: 0;
  }

  .filter-group legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
    padding: 0;
    margin-bottom: 0.5rem;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: center;
  }

  .filter-options button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .filter-options button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-options button[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .filter-options button:focus-visible,
  .cert-option input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cert-option {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .cert-option input {
    accent-color: var(--color-accent);
    margin: 0;
  }

  .matrix-search {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    min-height: 2.25rem;
    width: 14rem;
    max-width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .matrix-search:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .level-option {
    border-left: 1px solid var(--color-rule);
    padding-left: 0.75rem;
  }

  .matrix-legend {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .now-named {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    white-space: normal;
    color: var(--color-mute);
  }

  .level-mark {
    color: var(--color-mute);
  }

  .matrix-count {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .matrix-scroll {
    overflow-x: auto;
  }

  .matrix-table {
    min-width: 56rem;
  }

  .matrix-table thead th {
    position: sticky;
    top: 0;
    background: var(--color-paper);
    z-index: 1;
  }

  .matrix-table tbody th {
    font-family: var(--font-sans);
    font-weight: 600;
    text-align: left;
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
    white-space: nowrap;
  }

  .matrix-table td {
    font-size: 0.8rem;
  }

  .jurisdiction {
    display: block;
    color: var(--color-mute);
    font-size: 0.7rem;
  }

  .cols-toggle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .cols-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cols-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* First-visit scan set: hide Deployment + Pricing until the toggle expands.
     Applied only when the enhancement script adds .cols-collapsed, so the
     static (no-JS) table keeps every column. */
  .cols-collapsed .matrix-col-extra {
    display: none;
  }

  .matrix-note {
    margin: 1rem 0 0;
    max-width: 48rem;
    font-size: 0.8rem;
    color: var(--color-mute);
  }
</style>
