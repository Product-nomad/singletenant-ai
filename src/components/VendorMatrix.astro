---
// VendorMatrix: the site's hero component (spec §4): a dense, filterable
// comparison table driven entirely by the vendor YAML collection.
//
// Progressive enhancement: the full table renders statically; the filter
// bar ships `hidden` and is revealed by the enhancement script. With JS
// disabled the reader gets the complete matrix, never a broken filter.
import type { CollectionEntry } from 'astro:content';
import {
  CATEGORY_LABELS,
  CERT_LABELS,
  deploymentLabel,
  NOT_VERIFIED,
  regionLabel,
} from '../lib/labels.mjs';
import CategoryTag from './CategoryTag.astro';

interface Props {
  vendors: CollectionEntry<'vendors'>[];
  // Homepage passes this to default to the first-visit scan set (5 columns)
  // with a "Show all columns" toggle. The full directory omits it and shows
  // every column. Progressive enhancement: with JS off, the full table renders
  // either way (the collapse is applied by the enhancement script).
  collapsible?: boolean;
}

const { vendors, collapsible = false } = Astro.props;
const sorted = [...vendors].sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// Only offer filters for values that exist in the data, no dead controls.
const categoriesPresent = Object.keys(CATEGORY_LABELS).filter((c) =>
  sorted.some((v) => v.data.category === c),
);
const certsPresent = Object.keys(CERT_LABELS).filter((cert) =>
  sorted.some((v) => v.data.compliance.some((e) => e.cert === cert)),
);

const residencyLabel = (val: boolean | 'unknown') => {
  if (val === 'unknown') return NOT_VERIFIED;
  return val ? 'Guaranteed' : 'No guarantee';
};
const pricingLabel = (model: string) =>
  model === 'unknown' ? NOT_VERIFIED : model;
---

<div data-vendor-matrix data-collapsible={collapsible ? '' : undefined}>
  <form class="matrix-filters" data-matrix-filters hidden>
    <fieldset class="filter-group">
      <legend>Category</legend>
      <div class="filter-options" role="group">
        <button type="button" data-filter-cat="all" aria-pressed="true">All</button>
        {categoriesPresent.map((c) => (
          <button type="button" data-filter-cat={c} aria-pressed="false">
            {CATEGORY_LABELS[c as keyof typeof CATEGORY_LABELS]}
          </button>
        ))}
      </div>
    </fieldset>

    {certsPresent.length > 0 && (
      <fieldset class="filter-group">
        <legend>Compliance</legend>
        <div class="filter-options">
          {certsPresent.map((cert) => (
            <label class="cert-option">
              <input type="checkbox" data-filter-cert={cert} />
              {CERT_LABELS[cert as keyof typeof CERT_LABELS]}
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <p class="matrix-count" data-matrix-count aria-live="polite"></p>
  </form>

  {collapsible && (
    <button type="button" class="cols-toggle" data-cols-toggle aria-pressed="false" hidden>
      Show all columns
    </button>
  )}

  <div class="matrix-scroll">
    <table class="data-table matrix-table">
      <thead>
        <tr>
          <th scope="col">Vendor</th>
          <th scope="col">Category</th>
          <th scope="col" class="matrix-col-extra">Deployment</th>
          <th scope="col">Regions</th>
          <th scope="col">Compliance</th>
          <th scope="col" class="matrix-col-extra">Pricing</th>
          <th scope="col">Data residency</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map(({ data }) => (
          <tr
            data-matrix-row
            data-category={data.category}
            data-certs={data.compliance.map((e) => e.cert).join(' ')}
          >
            <th scope="row">
              <a href={`/vendors/${data.slug}/`}>{data.name}</a>
            </th>
            <td><CategoryTag category={data.category} /></td>
            <td class="matrix-col-extra">
              {data.deployment_models.length > 0
                ? data.deployment_models.map(deploymentLabel).join(', ')
                : NOT_VERIFIED}
            </td>
            <td>{data.regions.length > 0 ? data.regions.map(regionLabel).join(', ') : NOT_VERIFIED}</td>
            <td>
              {data.compliance.length > 0
                ? data.compliance
                    .map((e) => CERT_LABELS[e.cert as keyof typeof CERT_LABELS])
                    .join(', ')
                : NOT_VERIFIED}
            </td>
            <td class="matrix-col-extra">{pricingLabel(data.pricing.model)}</td>
            <td>
              {residencyLabel(data.sovereignty.data_residency_guarantee)}
              {data.sovereignty.parent_jurisdiction !== 'unknown' && (
                <span class="jurisdiction">({data.sovereignty.parent_jurisdiction} parent)</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="matrix-note">
    Category reflects a vendor's parent jurisdiction; a data-residency guarantee
    is a separate, per-vendor fact verified on its own evidence, so a
    sovereign-category vendor (EU or UK) can still read "Not verified" for
    residency (see
    <a href="/blog/jurisdiction-eu-region-not-sovereign/">why an EU region is not
    EU sovereign</a>).
  </p>
</div>

<script>
  for (const matrix of document.querySelectorAll('[data-vendor-matrix]')) {
    const filters = matrix.querySelector<HTMLElement>('[data-matrix-filters]');
    const rows = matrix.querySelectorAll<HTMLElement>('[data-matrix-row]');
    const count = matrix.querySelector<HTMLElement>('[data-matrix-count]');
    if (!filters) continue;

    const catButtons = filters.querySelectorAll<HTMLButtonElement>('[data-filter-cat]');
    const certBoxes = filters.querySelectorAll<HTMLInputElement>('[data-filter-cert]');
    let activeCat: string | string[] = 'all';

    const apply = () => {
      const wantedCerts = [...certBoxes]
        .filter((b) => b.checked)
        .map((b) => b.dataset.filterCert ?? '');
      let shown = 0;
      for (const row of rows) {
        const rowCat = row.dataset.category ?? '';
        const catOk =
          activeCat === 'all' ||
          (Array.isArray(activeCat) ? activeCat.includes(rowCat) : rowCat === activeCat);
        const rowCerts = (row.dataset.certs ?? '').split(' ');
        const certsOk = wantedCerts.every((c) => rowCerts.includes(c));
        const visible = catOk && certsOk;
        row.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === rows.length
            ? `All ${rows.length} vendors shown`
            : `${shown} of ${rows.length} vendors shown`;
      }
    };

    for (const btn of catButtons) {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.filterCat ?? 'all';
        for (const b of catButtons) {
          b.setAttribute('aria-pressed', String(b === btn));
        }
        apply();
      });
    }
    for (const box of certBoxes) {
      box.addEventListener('change', apply);
    }

    // Progressive enhancement for the homepage intent chips: a ?category=<slug>
    // deep link pre-activates that category filter. A comma-separated value
    // (?category=eu-sovereign,uk-sovereign, the UK & EU sovereignty chip) filters
    // to that set of categories, with no single button pressed. Without JS the
    // link simply lands on the full, unfiltered table (this block never runs), so
    // the chip still works, it just does not narrow the view.
    const wantedCatParam = new URLSearchParams(window.location.search).get('category');
    if (wantedCatParam) {
      const wanted = wantedCatParam
        .split(',')
        .map((s) => s.trim())
        .filter((w) => [...catButtons].some((b) => b.dataset.filterCat === w));
      if (wanted.length === 1) {
        const target = [...catButtons].find((b) => b.dataset.filterCat === wanted[0]);
        if (target) {
          activeCat = wanted[0];
          for (const b of catButtons) {
            b.setAttribute('aria-pressed', String(b === target));
          }
        }
      } else if (wanted.length > 1) {
        activeCat = wanted;
        for (const b of catButtons) {
          b.setAttribute('aria-pressed', 'false');
        }
      }
    }

    // First-visit column set (homepage only): collapse to the 5-column scan set
    // and offer a toggle that reveals Deployment + Pricing. Progressive
    // enhancement: the static table ships with every column, and this runs only
    // when JS is present, so no-JS readers always get the full table.
    const colsToggle = matrix.querySelector<HTMLButtonElement>('[data-cols-toggle]');
    if (matrix.hasAttribute('data-collapsible') && colsToggle) {
      matrix.classList.add('cols-collapsed');
      colsToggle.hidden = false;
      colsToggle.addEventListener('click', () => {
        const collapsed = matrix.classList.toggle('cols-collapsed');
        colsToggle.setAttribute('aria-pressed', String(!collapsed));
        colsToggle.textContent = collapsed
          ? 'Show all columns'
          : 'Show fewer columns';
      });
    }

    filters.hidden = false;
    apply();
  }
</script>

<style>
  .matrix-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 2.5rem;
    margin-bottom: 1.25rem;
  }

  .filter-group {
    border: none;
    margin: 0;
    padding: 0;
  }

  .filter-group legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
    padding: 0;
    margin-bottom: 0.5rem;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: center;
  }

  .filter-options button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .filter-options button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-options button[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .filter-options button:focus-visible,
  .cert-option input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cert-option {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .cert-option input {
    accent-color: var(--color-accent);
    margin: 0;
  }

  .matrix-count {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .matrix-scroll {
    overflow-x: auto;
  }

  .matrix-table {
    min-width: 56rem;
  }

  .matrix-table thead th {
    position: sticky;
    top: 0;
    background: var(--color-paper);
    z-index: 1;
  }

  .matrix-table tbody th {
    font-family: var(--font-sans);
    font-weight: 600;
    text-align: left;
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
    white-space: nowrap;
  }

  .matrix-table td {
    font-size: 0.8rem;
  }

  .jurisdiction {
    display: block;
    color: var(--color-mute);
    font-size: 0.7rem;
  }

  .cols-toggle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .cols-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cols-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* First-visit scan set: hide Deployment + Pricing until the toggle expands.
     Applied only when the enhancement script adds .cols-collapsed, so the
     static (no-JS) table keeps every column. */
  .cols-collapsed .matrix-col-extra {
    display: none;
  }

  .matrix-note {
    margin: 1rem 0 0;
    max-width: 48rem;
    font-size: 0.8rem;
    color: var(--color-mute);
  }
</style>
