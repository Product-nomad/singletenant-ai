---
// NewsletterSignup: email signup for guides and the changelog. Renders nothing
// unless FEATURES.newsletter is on. Posts to the newsletter Worker
// (workers/newsletter/). Works without JS: the Worker answers a plain form
// POST with a 303 back to this page's #newsletter-thanks or #newsletter-error
// anchor, and :target reveals the matching message. With JS the same request
// goes via fetch and the message is shown inline (inline script, so nothing
// ships while the flag is off). The hidden "website" field
// is a honeypot: humans never see it, bots fill it, and the Worker drops it.
import { FEATURES, NEWSLETTER_ENDPOINT } from '../config/features.mjs';

interface Props {
  // Where the form sits, recorded with the signup (e.g. "changelog").
  source: string;
}

const { source } = Astro.props;
---

{
  FEATURES.newsletter && (
    <aside class="newsletter" aria-labelledby="newsletter-heading">
      <h2 id="newsletter-heading" class="m-0 mb-2" style="font-size: 1.2rem;">
        Get data changes by email
      </h2>
      <p class="m-0 mb-4 text-sm" style="color: var(--color-ink-soft);">
        An occasional email when vendor data changes or a new guide is
        published. No vendor pays to appear in it. Unsubscribe at any time;
        see the <a href="/privacy/#newsletter">privacy policy</a>.
      </p>
      <form method="post" action={NEWSLETTER_ENDPOINT} data-newsletter>
        <input type="hidden" name="source" value={source} />
        <div class="newsletter-hp" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <div class="newsletter-row">
          <label class="newsletter-email">
            <span>Email address</span>
            <input type="email" name="email" required autocomplete="email" maxlength="254" />
          </label>
          <button type="submit" class="btn-primary">Subscribe</button>
        </div>
        <label class="newsletter-consent">
          <input type="checkbox" name="consent" value="yes" required />
          <span>Email me singletenant.ai updates. I can unsubscribe at any time.</span>
        </label>
      </form>
      <p id="newsletter-thanks" class="newsletter-msg" role="status" data-newsletter-ok>
        Thanks. Your address has been received.
      </p>
      <p id="newsletter-error" class="newsletter-msg" role="alert" data-newsletter-err>
        That did not go through. Check the address and the consent box, then
        try again.
      </p>
      <script is:inline>
        // Inline so it ships only when the form renders (flag on).
        for (const form of document.querySelectorAll('[data-newsletter]')) {
          const box = form.closest('.newsletter');
          const ok = box && box.querySelector('[data-newsletter-ok]');
          const err = box && box.querySelector('[data-newsletter-err]');
          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            ok?.classList.remove('is-shown');
            err?.classList.remove('is-shown');
            try {
              const res = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { accept: 'application/json' },
              });
              if (!res.ok) throw new Error(String(res.status));
              form.hidden = true;
              ok?.classList.add('is-shown');
            } catch {
              err?.classList.add('is-shown');
            }
          });
        }
      </script>
    </aside>
  )
}



<style>
  .newsletter {
    margin: 3rem 0 0;
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    background: var(--color-paper-deep);
  }

  .newsletter-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    margin-bottom: 0.75rem;
  }

  .newsletter-email {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1 1 16rem;
  }

  .newsletter-email span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .newsletter-email input {
    font: inherit;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .newsletter-consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .newsletter-msg {
    display: none;
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
  }

  .newsletter-msg:target,
  .newsletter-msg.is-shown {
    display: block;
  }
</style>
