---
// LastVerified — per-section date chip (spec §4). No date = the section's
// facts are unverified and say so; never render a bare claim.
interface Props {
  date?: string | undefined;
}

const { date } = Astro.props;
---

{
  date ? (
    <span class="last-verified">verified {date}</span>
  ) : (
    <span class="last-verified unverified">Not verified</span>
  )
}

<style>
  .last-verified {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    color: var(--color-mute);
    background: var(--color-paper);
    white-space: nowrap;
  }

  .unverified {
    border-style: dashed;
  }
</style>
