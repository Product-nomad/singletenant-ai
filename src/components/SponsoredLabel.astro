---
// SponsoredLabel: the mandatory marker for paid content (/disclosure/
// #sponsorship). Names the sponsor and links the disclosure page. ArticleLayout
// renders it automatically for any article with a `sponsor` in frontmatter, so
// sponsored content cannot ship unlabelled.
interface Props {
  sponsor: string;
}

const { sponsor } = Astro.props;
---

<p class="sponsored-label">
  <span class="sponsored-tag">Sponsored</span>
  Paid for by {sponsor}.
  <a href="/disclosure/#sponsorship">How sponsorship works</a>
</p>

<style>
  .sponsored-label {
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .sponsored-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
  }
</style>
