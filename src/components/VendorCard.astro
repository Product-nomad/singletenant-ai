---
import type { CollectionEntry } from 'astro:content';

interface Props {
  vendor: CollectionEntry<'vendors'>;
  variant?: 'compact' | 'full';
}

const { vendor, variant = 'full' } = Astro.props;
const { data } = vendor;
---

<article class="border border-[var(--color-rule)] p-6 transition-shadow hover:shadow-sm bg-[var(--color-paper)]">
  <div class="flex items-start justify-between mb-4">
    <div>
      <h3 class="m-0 mb-1" style="font-size: 1.5rem;">
        <a href={`/vendors/${data.slug}/`} class="no-underline">
          {data.name}
        </a>
      </h3>
      <p class="m-0 text-sm" style="color: var(--color-mute); font-style: italic;">
        {data.tagline}
      </p>
    </div>
    {data.partnership_status === 'affiliate' && (
      <span class="tag tag-accent">Partner</span>
    )}
  </div>

  {variant === 'full' && (
    <p class="text-sm mb-4" style="color: var(--color-ink-soft);">
      {data.description_short}
    </p>
  )}

  <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-mono mb-4 pb-4 border-b border-[var(--color-rule)]" style="color: var(--color-mute);">
    {data.headquartered && <span>📍 {data.headquartered}</span>}
    {data.founded && <span>Est. {data.founded}</span>}
    {data.funding_stage && <span>{data.funding_stage}</span>}
  </div>

  <div class="mb-3">
    <p class="eyebrow mb-2">Deployment</p>
    <div>
      {data.deployment_options.map((opt) => (
        <span class={`tag ${opt === 'single-tenant' || opt === 'vpc' ? 'tag-accent' : ''}`}>
          {opt}
        </span>
      ))}
    </div>
  </div>

  {data.compliance && data.compliance.length > 0 && (
    <div class="mb-3">
      <p class="eyebrow mb-2">Compliance</p>
      <div>
        {data.compliance.map((c) => (
          <span class="tag">{c}</span>
        ))}
      </div>
    </div>
  )}

  <div class="mt-5 flex items-center justify-between text-sm">
    <a href={`/vendors/${data.slug}/`} class="font-mono uppercase tracking-wider text-xs">
      Read profile →
    </a>
    <a href={data.url} target="_blank" rel="noopener noreferrer"
       class="font-mono text-xs" style="color: var(--color-mute);">
      {data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗
    </a>
  </div>
</article>
