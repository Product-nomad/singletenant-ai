---
// EvidenceLink: external link to a primary source, always showing the
// domain so the reader can judge the source before clicking (spec §4).
interface Props {
  url: string;
}

const { url } = Astro.props;
const domain = new URL(url).hostname.replace(/^www\./, '');
---

<a class="evidence-link" href={url} target="_blank" rel="noopener noreferrer">
  {domain}&nbsp;↗
</a>

<style>
  .evidence-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    text-decoration-color: var(--color-accent-soft);
    white-space: nowrap;
  }

  .evidence-link:hover {
    color: var(--color-accent-deep);
  }
</style>
