---
import type { CollectionEntry } from 'astro:content';
import {
  CATEGORY_LABELS,
  CERT_LABELS,
  deploymentLabel,
  displayName,
  evidenceLevelLabel,
  regionLabel,
} from '../lib/labels.mjs';

interface Props {
  vendors: CollectionEntry<'vendors'>[];
}

const { vendors } = Astro.props;

type VendorData = CollectionEntry<'vendors'>['data'];
type CellValue = string | boolean | string[] | undefined;

// Schema v2 facts in display order. 'unknown' renders as "Not verified",
// never as a blank that could read as "none".
const rows: Array<{
  label: string;
  get: (d: VendorData) => CellValue;
  type?: 'tags' | 'list';
}> = [
  {
    label: 'Category',
    get: (d) =>
      CATEGORY_LABELS[d.category as keyof typeof CATEGORY_LABELS] ?? d.category,
  },
  {
    label: 'Deployment models',
    get: (d) => d.deployment_models.map(deploymentLabel),
    type: 'tags',
  },
  { label: 'Regions', get: (d) => d.regions.map(regionLabel), type: 'list' },
  {
    label: 'Compliance',
    get: (d) =>
      d.compliance.map(
        (c) =>
          `${CERT_LABELS[c.cert as keyof typeof CERT_LABELS] ?? c.cert}${c.level === 'stated' ? ' (stated)' : ''}`,
      ),
    type: 'tags',
  },
  { label: 'Pricing model', get: (d) => d.pricing.model },
  { label: 'Public pricing', get: (d) => d.pricing.public },
  {
    label: 'Data residency evidence',
    get: (d) => evidenceLevelLabel(d.sovereignty.data_residency_guarantee),
  },
  {
    label: 'Parent jurisdiction',
    get: (d) => d.sovereignty.parent_jurisdiction,
  },
  { label: 'Analyst note', get: (d) => d.notes },
];

function fmt(val: CellValue): string {
  if (val === 'unknown' || val === undefined) return 'Not verified';
  if (typeof val === 'boolean') return val ? 'Yes' : 'No';
  return String(val);
}
---

<div class="overflow-x-auto -mx-6 px-6 sm:mx-0 sm:px-0">
  <table class="data-table w-full">
    <thead>
      <tr>
        <th class="w-44"></th>
        {vendors.map((v) => (
          <th class="text-left">
            <a href={`/vendors/${v.data.slug}/`} class="no-underline">
              <span class="font-display font-semibold text-base normal-case tracking-normal" style="color: var(--color-ink);">
                {displayName(v.data)}
              </span>
            </a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td class="font-medium" style="font-family: var(--font-body); color: var(--color-mute); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;">
            {row.label}
          </td>
          {vendors.map((v) => {
            const val = row.get(v.data);
            if (row.type === 'tags' && Array.isArray(val)) {
              return (
                <td>
                  {val.length === 0
                    ? 'Not verified'
                    : val.map((item) => <span class="tag">{item}</span>)}
                </td>
              );
            }
            if (row.type === 'list' && Array.isArray(val)) {
              return (
                <td style="font-family: var(--font-body); font-size: 0.875rem;">
                  {val.length === 0 ? 'Not verified' : val.join(', ')}
                </td>
              );
            }
            return (
              <td style="font-family: var(--font-body); font-size: 0.875rem; line-height: 1.5;">
                {fmt(val as string | boolean | undefined)}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
