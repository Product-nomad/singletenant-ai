---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-rule)]" style="background: var(--color-paper-deep);">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <!-- Link columns -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 mb-10">
      <div>
        <p class="eyebrow mb-3">Data</p>
        <ul class="list-none p-0 m-0 space-y-2 text-sm">
          <li><a href="/vendors/">All vendors</a></li>
          <li><a href="/compare/">Comparisons</a></li>
          <li><a href="/changelog/">Changelog</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">About</p>
        <ul class="list-none p-0 m-0 space-y-2 text-sm">
          <li><a href="/blog/">Analysis</a></li>
          <li><a href="/methodology/">Methodology</a></li>
          <li><a href="/about/">About this site</a></li>
          <li><a href="/contact/">Consulting</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">Legal</p>
        <ul class="list-none p-0 m-0 space-y-2 text-sm">
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/disclosure/">Disclosure</a></li>
        </ul>
      </div>
    </div>

    <!-- Colophon -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-8 border-t border-[var(--color-rule)] text-sm"
    >
      <p class="m-0" style="color: var(--color-mute);">
        © {year} singletenant.ai · Independent, evidence-linked reference data. Some links may earn
        referral commission; we mark these clearly.
      </p>
      <p class="font-mono text-xs m-0" style="color: var(--color-mute);">
        Set in Inter &amp; JetBrains Mono
      </p>
    </div>
  </div>
</footer>
